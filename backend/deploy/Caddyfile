# Caddy in front of gunicorn (deploy/systemd/data-jockey-web.service).
# Copied to /etc/caddy/Caddyfile by deploy/setup.sh.
#
# Served on mattdixon.uk: Caddy gets and renews a Let's Encrypt certificate by
# itself (HTTP challenge on port 80) and redirects HTTP to HTTPS. The domain's A
# records (Porkbun DNS: the bare domain and www) must point at the Elastic IP, which
# changes after ./deploy web-kill + web-start. Requests to the bare IP get nothing.
# The domain is also set in scripts/deploy.sh (SITE_DOMAIN).
#
# reverse_proxy sets X-Forwarded-For to the real client address, replacing any
# value the client sent; Django reads it with DJANGO_NUM_PROXIES=1.
#
# The React app (built by scripts/deploy.sh, unpacked to ./site) is served from
# here as static files; only the APIs go to Django (and /static/ comes from collectstatic). Unknown paths
# get index.html so React Router can handle them (/races/123, /scorecard).
#
# The Django admin is not public: /admin is a 404 here. Reach it through an SSM tunnel
# straight to gunicorn (http://localhost:8000/admin/, see CLAUDE.md), which skips Caddy.
mattdixon.uk {
  encode zstd gzip

  handle /admin* {
    respond 404
  }

  @django path /api/* /graphql*
  # collectstatic's output (admin and browsable API CSS/JS), straight from disk.
  handle /static/* {
    root * /opt/data-jockey/backend/staticfiles
    uri strip_prefix /static
    file_server
  }

  handle @django {
    reverse_proxy 127.0.0.1:8000
  }

  handle {
    root * /opt/data-jockey/backend/site
    # Vite fingerprints everything under /assets/, so it can be cached for good.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
  }
}

www.mattdixon.uk {
  redir https://mattdixon.uk{uri} permanent
}
