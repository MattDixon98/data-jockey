# Fetches the serving snapshot from S3 if it has changed and swaps it in
# (racing/management/commands/fetch_snapshot.py). Started by
# data-jockey-snapshot.timer; run by hand with
#   sudo systemctl start data-jockey-snapshot.service
#
# Paths and the user are placeholders until the data-jockey-web stack sets up
# the server: app checkout in /opt/data-jockey, its virtualenv in
# /opt/data-jockey/venv, settings (DJANGO_SECRET_KEY, DATA_JOCKEY_SNAPSHOT,
# DATA_JOCKEY_SNAPSHOT_S3_URI...) in /etc/data-jockey/env. AWS credentials
# come from the instance role.
[Unit]
Description=Data Jockey: fetch the serving snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=data-jockey
Group=data-jockey
WorkingDirectory=/opt/data-jockey/backend
EnvironmentFile=/etc/data-jockey/env
ExecStart=/opt/data-jockey/venv/bin/python manage.py fetch_snapshot
