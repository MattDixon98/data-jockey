# Copy to backend/.env for local development:  cp .env.example .env
# backend/.env is git-ignored — never commit real values.

# "true" only for local development. Leave unset (defaults to false) anywhere public.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is not true. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
